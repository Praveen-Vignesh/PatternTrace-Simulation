# The browser-safe key: either the newer publishable key (sb_publishable_...)
# or the legacy anon key. Never the secret / service_role key.
#
# Auth: the app uses email + password (anonymous sign-in was removed). In the
# Supabase dashboard, keep the Email provider enabled, and for instant play
# disable "Confirm email" (Authentication -> Providers -> Email) — otherwise a
# new account has no session until the emailed link is clicked, and the first
# session cannot be saved. Data is only ever written for a signed-in account.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key
